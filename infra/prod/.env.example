# infra/prod/.env.example
#
# Copy to .env and fill in real values. Never commit .env (already gitignored).
# On the VM, .env should be mode 600 and owned by the deploy user.

# ── Image tag ─────────────────────────────────────────────────────────────
# Set by CI on every deploy to the git SHA. Defaults to :latest if unset.
API_IMAGE_TAG=latest

# ── Postgres ──────────────────────────────────────────────────────────────
# IMPORTANT: this password is only honoured on the *first* boot of an empty
# data dir (postgres initdb). Changing it later in .env does nothing — you
# must `ALTER USER smartscale WITH PASSWORD '...'` inside the running
# container, then update .env to match.
POSTGRES_PASSWORD=replace-with-32-random-chars

# Optional: override the on-disk data location.
# Defaults to ./postgres-data (relative to this file, gitignored).
# On the VM, set to /mnt/postgres-data (the mounted Hetzner Volume).
# POSTGRES_DATA_DIR=/mnt/postgres-data

# ── API ───────────────────────────────────────────────────────────────────
# Long-lived shared secret enforced by DeviceKeyMiddleware. The mobile app
# must be built with --dart-define=DEVICE_KEY=<same value>.
DEVICE_KEY=replace-with-32-random-chars

# Optional admin credential for non-device clients (e.g. the scraper worker,
# which has no device identity). When set, requests may authenticate with
# `X-Admin-Key: <this value>` instead of X-Device-Key. Leave empty/unset to
# disable the admin auth path entirely.
# ADMIN_KEY=replace-with-32-random-chars

# OpenAI key for Whisper (voice match endpoint).
OPENAI_API_KEY=sk-...

# Optional: Whisper model override. Defaults to whisper-1.
# WHISPER_MODEL=whisper-1

# ── Caddy / TLS ───────────────────────────────────────────────────────────
# Domain Caddy will serve. Must have an A-record pointing at this VM
# before first `up`, or Let's Encrypt cert issuance will fail.
DOMAIN=api.example.tld

# Email used for Let's Encrypt account registration + renewal notices.
ACME_EMAIL=you@example.tld

# Optional: override Caddy data dir (TLS certs). Defaults to ./caddy-data.
# On the VM, point at the Hetzner Volume so certs survive VM rebuilds.
# CADDY_DATA_DIR=/mnt/caddy-data
