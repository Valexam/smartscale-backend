            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "per_100g": {
            "$ref": "#/components/schemas/Per100gIn-Output"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "device_id",
          "name",
          "brand",
          "per_100g",
          "default_serving_g",
          "created_at",
          "updated_at"
        ],
        "title": "UserFoodOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceCandidate": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pantry_item_id": {
            "title": "Pantry Item Id",
            "type": "string"
          },
          "weight_grams": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Weight Grams",
            "type": "string"
          }
        },
        "required": [
          "pantry_item_id",
          "name",
          "weight_grams",
          "confidence"
        ],
        "title": "VoiceCandidate",
        "type": "object"
      },
      "VoiceMatchResponse": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VoiceCandidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "transcript": {
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "transcript"
        ],
        "title": "VoiceMatchResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SmartScale API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/healthz": {
      "get": {
        "operationId": "healthz_v1_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz V1 Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/measurements": {
      "get": {
        "operationId": "list_measurements_v1_measurements_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "device_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Device Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementListResponse"
                }
              }
            },
            "description": "Paginated list of measurements (most recent first)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Measurements",
        "tags": [
          "measurements"
        ]
      },
      "post": {
        "operationId": "create_measurement_v1_measurements_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeasurementRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "description": "Created with computed macros (product known)."
          },
          "202": {
            "description": "Created without macros (product unknown)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Measurement",
        "tags": [
          "measurements"
        ]
      }
    },
    "/v1/pantry": {
      "get": {
        "operationId": "list_pantry_v1_pantry_get",
        "parameters": [
          {
            "in": "query",
            "name": "device_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Device Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PantryListResponse"
                }
              }
            },
            "description": "Live pantry items, most-recently-used first."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Pantry",
        "tags": [
          "pantry"
        ]
      },
      "post": {
        "operationId": "add_pantry_item_v1_pantry_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PantryAddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PantryItemOut"
                }
              }
            },
            "description": "Pantry item added."
          },
          "404": {
            "description": "Source not found (barcode/user_food_id)."
          },
          "422": {
            "description": "Validation error."
          }
        },
        "summary": "Add Pantry Item",
        "tags": [
          "pantry"
        ]
      }
    },
    "/v1/pantry/{pantry_item_id}": {
      "delete": {
        "operationId": "archive_pantry_item_v1_pantry__pantry_item_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "pantry_item_id",
            "required": true,
            "schema": {
              "title": "Pantry Item Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "device_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Device Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Archived (idempotent if already archived)."
          },
          "404": {
            "description": "Pantry item not found for this device."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Archive Pantry Item",
        "tags": [
          "pantry"
        ]
      }
    },
    "/v1/pantry/{pantry_item_id}/log": {
      "post": {
        "operationId": "log_from_pantry_v1_pantry__pantry_item_id__log_post",
        "parameters": [
          {
            "in": "path",
            "name": "pantry_item_id",
            "required": true,
            "schema": {
              "title": "Pantry Item Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PantryLogRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementResponse"
                }
              }
            },
            "description": "Measurement logged from pantry."
          },
          "404": {
            "description": "Pantry item not found."
          },
          "410": {
            "description": "Pantry item is archived; cannot log."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Log From Pantry",
        "tags": [
          "pantry"
        ]
      }
    },
    "/v1/products/{barcode}": {
      "get": {
        "operationId": "get_product_v1_products__barcode__get",
        "parameters": [
          {
            "in": "path",
            "name": "barcode",
            "required": true,
            "schema": {
              "title": "Barcode",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductGetResponse"
                }
              }
            },
            "description": "Product found."
          },
          "404": {
            "description": "Product not found."
          },
          "422": {
            "description": "Invalid barcode format."
          }
        },
        "summary": "Get Product",
        "tags": [
          "products"
        ]
      },
      "put": {
        "operationId": "put_product_v1_products__barcode__put",
        "parameters": [
          {
            "in": "path",
            "name": "barcode",
            "required": true,
            "schema": {
              "title": "Barcode",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductPutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPutResponse"
                }
              }
            },
            "description": "Existing product replaced."
          },
          "201": {
            "description": "New product created."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Put Product",
        "tags": [
          "products"
        ]
      }
    },
    "/v1/products/{barcode}/refresh": {
      "post": {
        "operationId": "refresh_product_v1_products__barcode__refresh_post",
        "parameters": [
          {
            "in": "path",
            "name": "barcode",
            "required": true,
            "schema": {
              "title": "Barcode",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductRefreshResponse"
                }
              }
            },
            "description": "Refresh queued. Scraper picks it up on next cycle."
          },
          "422": {
            "description": "Invalid barcode format."
          }
        },
        "summary": "Refresh Product",
        "tags": [
          "products"
        ]
      }
    },
    "/v1/user-foods": {
      "post": {
        "operationId": "create_user_food_v1_user_foods_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserFoodCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserFoodOut"
                }
              }
            },
            "description": "Free-form food created."
          },
          "422": {
            "description": "Validation error (macros, name length, ...)."
          }
        },
        "summary": "Create User Food",
        "tags": [
          "user-foods"
        ]
      }
    },
    "/v1/voice/match": {
      "post": {
        "operationId": "voice_match_v1_voice_match_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_voice_match_v1_voice_match_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceMatchResponse"
                }
              }
            },
            "description": "Transcription + top-3 pantry candidates (empty list if none match)."
          },
          "400": {
            "description": "Audio missing or empty."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "description": "Whisper upstream error."
          },
          "503": {
            "description": "OPENAI_API_KEY not configured on the server."
          }
        },
        "summary": "Voice Match",
        "tags": [
          "voice"
        ]
      }
    }
  }
}
